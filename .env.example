# 必填：Apify token，用于稳定抓取 X / Instagram
APIFY_TOKEN=apify_api_xxx

# 可选：自定义 Apify Actor
APIFY_X_ACTOR=61RPP7dywgiy0JPD0
APIFY_IG_ACTOR=apify/instagram-scraper

# 必填：LLM（OpenAI 兼容接口）
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 抓取配置
X_QUERY=AI OR 创业 min_faves:300 lang:en
IG_HASHTAG=ai
FETCH_COUNT=20
DAILY_TOP_N=3

# 本地持久化
OUTPUT_DIR=output
DB_PATH=data/state.db
